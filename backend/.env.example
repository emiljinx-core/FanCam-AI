# Resend email delivery for the contact form
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Inbox that receives contact form submissions
CONTACT_EMAIL_TO=you@example.com

# Verified sender. Free Resend accounts may use onboarding@resend.dev
# to send to the email address that owns the account.
CONTACT_EMAIL_FROM=onboarding@resend.dev
